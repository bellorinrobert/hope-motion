# -----------------------------------------------------------------------------
# Hope Motion — environment variables (example)
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# -----------------------------------------------------------------------------

# Public base URL of the deployment (used for SEO metadata, sitemap and robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official GoFundMe campaign URL.
NEXT_PUBLIC_GOFUNDME_URL=https://www.gofundme.com/f/ayuda-a-andrea-a-volver-a-caminar-sin-muletas

# Optional contact channel shown in the footer (WhatsApp number in international
# format, digits only, e.g. 584121234567). Leave empty to hide the button.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Deployment environment label used by Next.js.
NODE_ENV=development

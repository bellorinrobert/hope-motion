# -----------------------------------------------------------------------------
# Hope Motion — Environment Variables
# -----------------------------------------------------------------------------

# Cloudflare Workers authentication (PRIVATE)
CLOUDFLARE_API_TOKEN=PEGA_AQUI_TU_TOKEN

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GoFundMe
NEXT_PUBLIC_GOFUNDME_URL=https://www.gofundme.com/f/ayuda-a-andrea-a-volver-a-caminar-sin-muletas

# WhatsApp
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Local development
NODE_ENV=development
